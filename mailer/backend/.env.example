# Copy to .env or export in your shell / host dashboard.

# One account:
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Or multiple (primary;fallback):
# GMAIL_ACCOUNTS=you@gmail.com:xxxx xxxx xxxx xxxx;backup@gmail.com:yyyy yyyy yyyy yyyy

# Protect the API (required when frontend is public)
API_KEY=change-me-to-a-long-random-string

# Optional: restrict browser origins (comma-separated). Default *
# CORS_ORIGINS=https://yourname.pages.dev,http://127.0.0.1:5500

# Optional data directory
# DATA_DIR=/home/you/mailer-data

PORT=8000
